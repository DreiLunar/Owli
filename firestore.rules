rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================
    // HELPERS
    // ================================================
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    function ownerUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    function validId(value) {
      return value is string
        && value.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function validText(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function isDeleting(data) {
      return data.get('deleting', false) == true;
    }

    // Not used yet. Add "&& ownsSubject(...)" to the notes and decks
    // create/update rules once subjects are implemented.
    function ownsSubject(subjectId) {
      return get(/databases/$(database)/documents/subjects/$(subjectId)).data.ownerId
        == request.auth.uid;
    }

    function ownsDeck(deckId) {
      let deck = get(/databases/$(database)/documents/decks/$(deckId)).data;
      return signedIn() && deck.ownerId == request.auth.uid;
    }

    function activeDeckAfter(deckId) {
      let deck = getAfter(/databases/$(database)/documents/decks/$(deckId)).data;
      return signedIn()
        && deck.ownerId == request.auth.uid
        && !isDeleting(deck);
    }

    function progressRemovedAfter(deckId, cardId) {
      let id = request.auth.uid + '~' + deckId + '~' + cardId;
      return !existsAfter(/databases/$(database)/documents/progress/$(id));
    }

    function canDeleteCard(deckId, cardId) {
      let deck = get(/databases/$(database)/documents/decks/$(deckId)).data;
      return signedIn()
        && deck.ownerId == request.auth.uid
        && (isDeleting(deck) || progressRemovedAfter(deckId, cardId));
    }

    function validDeck(data) {
      return data.keys().hasAll([
          'ownerId', 'subjectId', 'title', 'description',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'subjectId', 'title', 'description',
          'createdAt', 'updatedAt', 'deleting'
        ])
        && validId(data.ownerId)
        && validId(data.subjectId)
        && validText(data.title, 80)
        && data.description is string
        && data.description.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.get('deleting', false) is bool;
    }

    function validCard(data, deckId) {
      return data.keys().hasAll([
          'deckId', 'front', 'back', 'sourceNoteId',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'deckId', 'front', 'back', 'sourceNoteId',
          'createdAt', 'updatedAt'
        ])
        && data.deckId == deckId
        && validText(data.front, 10000)
        && validText(data.back, 10000)
        && data.sourceNoteId == null
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ================================================
    // USERS
    // ================================================
    match /users/{userId} {
      allow read, create, update, delete:
        if signedIn() && request.auth.uid == userId;
    }

    // ================================================
    // SUBJECTS
    // ================================================
    match /subjects/{id} {
      allow read, delete: if isOwner(resource.data);

      allow create: if isOwner(request.resource.data)
        && validText(request.resource.data.title, 60)
        && request.resource.data.color is int;

      allow update: if isOwner(resource.data)
        && ownerUnchanged()
        && validText(request.resource.data.title, 60)
        && request.resource.data.color is int;
    }

    // ================================================
    // NOTES
    // ================================================
    match /notes/{id} {
      allow read, delete: if isOwner(resource.data);

      allow create: if isOwner(request.resource.data)
        && validText(request.resource.data.title, 200)
        && request.resource.data.content is string
        && request.resource.data.subjectId is string;

      allow update: if isOwner(resource.data)
        && ownerUnchanged()
        && validText(request.resource.data.title, 200)
        && request.resource.data.content is string
        && request.resource.data.subjectId is string;
    }

    // ================================================
    // DECKS
    // ================================================
    match /decks/{deckId} {
      allow read:
        if signedIn() && resource.data.ownerId == request.auth.uid;

      allow create:
        if signedIn()
        && validId(deckId)
        && validDeck(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && !isDeleting(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update:
        if signedIn()
        && resource.data.ownerId == request.auth.uid
        && !isDeleting(resource.data)
        && validDeck(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (
          (
            !isDeleting(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title', 'description', 'updatedAt'])
          )
          ||
          (
            isDeleting(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['deleting', 'updatedAt'])
          )
        );

      allow delete:
        if signedIn()
        && resource.data.ownerId == request.auth.uid
        && isDeleting(resource.data);

      // ---------- cards ----------
      match /cards/{cardId} {
        allow read: if ownsDeck(deckId);

        allow create:
          if activeDeckAfter(deckId)
          && validId(cardId)
          && validCard(request.resource.data, deckId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update:
          if activeDeckAfter(deckId)
          && validCard(request.resource.data, deckId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['front', 'back', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (
            (
              request.resource.data.front == resource.data.front
              && request.resource.data.back == resource.data.back
            )
            || progressRemovedAfter(deckId, cardId)
          );

        allow delete: if canDeleteCard(deckId, cardId);
      }
    }

    // ================================================
    // PROGRESS
    // ================================================
    match /progress/{progressId} {

      function validProgress() {
        let data = request.resource.data;

        return signedIn()
          && data.keys().hasAll([
            'userId', 'deckId', 'cardId',
            'lastResult', 'lastReviewedAt', 'nextReviewAt'
          ])
          && data.keys().hasOnly([
            'userId', 'deckId', 'cardId',
            'lastResult', 'lastReviewedAt', 'nextReviewAt'
          ])
          && data.userId == request.auth.uid
          && validId(data.userId)
          && validId(data.deckId)
          && validId(data.cardId)
          && progressId == (data.userId + '~' + data.deckId + '~' + data.cardId)
          && data.lastResult in ['gotIt', 'stillLearning']
          && data.lastReviewedAt == request.time
          && data.nextReviewAt == null
          && activeDeckAfter(data.deckId)
          && getAfter(
               /databases/$(database)/documents/decks/$(data.deckId)/cards/$(data.cardId)
             ).data.deckId == data.deckId;
      }

      allow read:
        if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if validProgress();

      allow update:
        if validProgress()
        && resource.data.userId == request.auth.uid
        && resource.data.userId == request.resource.data.userId
        && resource.data.deckId == request.resource.data.deckId
        && resource.data.cardId == request.resource.data.cardId;

      allow delete:
        if signedIn()
        && (
          (resource != null && resource.data.userId == request.auth.uid)
          ||
          (
            resource == null
            && validId(request.auth.uid)
            && progressId.matches(
                 request.auth.uid + '~[A-Za-z0-9_-]{1,128}~[A-Za-z0-9_-]{1,128}'
               )
          )
        );
    }
  }
}