rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }

    function isOwner(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    function ownerUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    function titleOk(max) {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= max;
    }

    // The subject referenced by a new/updated deck or note must belong to the caller.
    function ownsSubject(subjectId) {
      return get(/databases/$(database)/documents/subjects/$(subjectId)).data.ownerId
        == request.auth.uid;
    }

    function deckOwner(deckId) {
      return signedIn()
        && get(/databases/$(database)/documents/decks/$(deckId)).data.ownerId
          == request.auth.uid;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read, update: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.email is string;
      allow delete: if false;
    }

    // ---------- subjects ----------
    match /subjects/{id} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data)
        && titleOk(60)
        && request.resource.data.color is int;
      allow update: if isOwner(resource.data) && ownerUnchanged()
        && titleOk(60)
        && request.resource.data.color is int;
    }

    // ---------- notes ----------
    match /notes/{id} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data)
        && titleOk(200)
        && request.resource.data.content is string
        && request.resource.data.subjectId is string
        && ownsSubject(request.resource.data.subjectId);
      allow update: if isOwner(resource.data) && ownerUnchanged()
        && titleOk(200)
        && request.resource.data.content is string
        && request.resource.data.subjectId is string
        && ownsSubject(request.resource.data.subjectId);
    }

    // ---------- decks and cards ----------
    match /decks/{deckId} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data)
        && titleOk(100)
        && request.resource.data.subjectId is string
        && ownsSubject(request.resource.data.subjectId);
      allow update: if isOwner(resource.data) && ownerUnchanged()
        && titleOk(100)
        && request.resource.data.subjectId is string
        && ownsSubject(request.resource.data.subjectId);

      match /cards/{cardId} {
        allow read, delete: if deckOwner(deckId);
        allow create, update: if deckOwner(deckId)
          && request.resource.data.front is string
          && request.resource.data.front.size() > 0
          && request.resource.data.back is string
          && request.resource.data.back.size() > 0;
      }
    }

    // ---------- progress ----------
    match /progress/{progressId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.cardId is string
        && request.resource.data.deckId is string
        && progressId == request.auth.uid + '_' + request.resource.data.cardId;
    }

   
  }
}